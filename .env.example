# Set in your hosting dashboard (Functions scope on Netlify). Do not commit real secrets.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=replace-with-at-least-32-random-characters
# Optional comma-separated provider hostnames to restrict which addons may be queried.
ALLOWED_ADDON_HOSTS=
PORT=3000
